# Contact-form email delivery (optional — the form shows a mailto fallback
# until these are set). Uses Resend: https://resend.com
#
# Add these in Vercel under Project → Settings → Environment Variables, then
# redeploy — env changes do not reach a deployment that is already running.
#
# Paste values UNQUOTED there. The quotes below are dotenv syntax for this
# file; Vercel's field takes the raw value, so pasted quotes end up inside it
# and Resend rejects the address.

RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend. Sending from an
# unverified domain is the usual cause of a rejected message.
CONTACT_FROM_EMAIL="Warm Transfer Solutions <noreply@warmtransfersolutions.com>"
# Where enquiries are delivered. Falls back to site.email in lib/site.ts.
CONTACT_TO_EMAIL=

# Contact-form hand-off to the CRM, so each enquiry also lands under
# Sales -> Leads. The post is made server-side only; the secret never reaches
# the browser. With the secret unset the hand-off is skipped and the enquiry
# still goes out by email.
#
# LEADS_WEBHOOK_SECRET must be byte-for-byte the same value as the one set on
# the CRM project, or the CRM answers 401 and the lead is dropped.
LEADS_WEBHOOK_SECRET=
# Optional override. Defaults to https://app.warmtransfersolutions.com/api/leads
CRM_LEADS_URL=
